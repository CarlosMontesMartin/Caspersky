# Copia este archivo como .env y rellena los valores. .env NUNCA se sube a git.

# URL con la que se abre la app. Para el demo con móvil: http://<IP del portátil>:8000
BASE_URL=http://localhost:8000

# Clave del proveedor de IA (UPC 1). Sin ella todo funciona en modo de respaldo.
LLM_API_KEY=

# 1 = activa POST /encuestas/{id}/simular (solo para la demo y las pruebas)
MODO_DEMO=0

# URL del workflow de Teams 'Post to a channel when a webhook request is received'. Es secreta:
# no la compartas ni la subas a git. Vacía = Teams sin conectar (solo vista previa).
# Solo se acepta https y de logic.azure.com, powerplatform.com, powerautomate.com u office.com.
# Para que el botón "Responder" funcione en otros equipos, BASE_URL no puede ser localhost.
TEAMS_WEBHOOK_URL=
